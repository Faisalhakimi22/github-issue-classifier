# Copy to .env (gitignored). Never commit real values.

# ---------------------------------------------------------------------------
# Data collection / training (ghic.collect)
# ---------------------------------------------------------------------------
# Fine-grained PAT from https://github.com/settings/tokens with public repo
# read access — no write scopes needed. Only used for dataset collection.
GH_TOKEN=ghp_replace_me

# ---------------------------------------------------------------------------
# Webhook service (ghic.service) — all optional in dev, required in prod
# ---------------------------------------------------------------------------
# Secret configured on the GitHub App's webhook settings page.
GHIC_WEBHOOK_SECRET=

# GitHub App credentials (App settings -> General). The private key can be
# passed inline (GHIC_PRIVATE_KEY) or as a file path (GHIC_PRIVATE_KEY_PATH).
GHIC_APP_ID=
GHIC_PRIVATE_KEY_PATH=

# Model + decision threshold. Default prefers models/champion.joblib (the
# calibrated walk-forward-selected model) and falls back to rf_balanced.
GHIC_MODEL_PATH=
GHIC_THRESHOLD=0.5
# Per-repo overrides — run `python -m ghic.backtest` to calibrate these.
# GHIC_REPO_THRESHOLDS=owner/repo=0.35,other/repo=0.6
GHIC_REPO_THRESHOLDS=

# Actions. Everything defaults to the safe side: dry-run on, writes off.
GHIC_DRY_RUN=true
GHIC_POST_COMMENT=false
GHIC_APPLY_LABEL=false
GHIC_LABEL_NAME=predicted:actionable-bug
# Projects v2 board node ID (PVT_...). When set, issues predicted actionable
# are added to the board. Needs the App's Projects write permission.
GHIC_PROJECT_ID=

# Enrichment (author profile + latest release via the GitHub API).
GHIC_ENRICH=true

# Online-evaluation ledger (predictions graded when issues close).
# Unset = data/predictions.jsonl; empty = in-memory only.
# GHIC_LEDGER=data/predictions.jsonl

# Postgres-backed ledger — required on deploys with no persistent disk
# (Vercel; see docs/DEPLOYMENT.md "Deploying on Vercel"). Takes precedence
# over GHIC_LEDGER when set. Vercel's own Postgres integration injects
# DATABASE_URL/POSTGRES_URL automatically; GHIC_DATABASE_URL overrides both.
# GHIC_DATABASE_URL=postgres://user:pass@host:5432/dbname

# Duplicate candidates (requires models/dup_index.joblib from
# `python -m ghic.dupdetect --build-index`). Assistive only.
GHIC_SUGGEST_RELATED=true
GHIC_RELATED_MIN_SIM=0.55

# Category suggestion (requires models/category.joblib from
# `python -m ghic.category --train`). Assistive only — never auto-labeled.
GHIC_SUGGEST_CATEGORY=true

# Coarse resolution-time bucket in the API response (never in comments).
# Requires models/effort.joblib — only produced when the effort experiment
# meets its pre-declared ship bar (see models/EFFORT_CARD.md).
GHIC_ESTIMATE_EFFORT=true

# Maintainer suggestions in the API response (never an assignment, never an
# @-mention). Requires the dup index + data/processed/assignments.json
# (`python -m ghic.assign --collect`).
GHIC_SUGGEST_ASSIGNEES=true

# LLM-drafted "missing information" comments (off by default; degrades to a
# deterministic template without an API key). The classifier's decision is
# never delegated to the LLM. Skipped automatically when GHIC_USE_LLM_ANALYSIS
# below is on and succeeds -- that feature's own missing_information already
# covers this, so both would be a redundant second LLM call.
GHIC_DRAFT_MISSING_INFO=false
# ANTHROPIC_API_KEY=sk-ant-...
# GHIC_LLM_MODEL=claude-opus-4-8

# LLM-assisted issue analysis (category/priority/severity/summary/reasoning/
# missing-info/label suggestions) -- a separate feature from the missing-info
# drafter above, with its own model(s). Off by default until this flag AND at
# least one of the two keys below are set. Never recomputes or overrides the
# ML classifier's actionability probability -- see models/LLM_ANALYSIS_CARD.md.
#
# Two providers, priority chain: Groq is the fast primary (openai/gpt-oss-120b
# measured ~1.9s/call -- comfortably inside the webhook's response budget);
# OpenRouter is the fallback (nemotron free tier measured ~17s/call -- too
# slow as a primary, fine as a rarely-hit backup). Set GROQ_API_KEY alone,
# OPENROUTER_API_KEY alone, or both (chain: Groq tried first, OpenRouter only
# if Groq fails). Free keys: https://console.groq.com/keys and
# https://openrouter.ai/keys.
GHIC_USE_LLM_ANALYSIS=false
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Asynchronous webhook processing (validate -> queue -> return 200 fast ->
# process + comment later) via Upstash QStash. Off by default -- /webhook
# processes every issue inline otherwise, same as always. Real background
# execution (FastAPI BackgroundTasks, Vercel's waitUntil) isn't reliable on
# Vercel's Python runtime, and Vercel's Cron Jobs are daily-only on Hobby --
# see models/ASYNC_PROCESSING_CARD.md for why a real queue is the correct
# fix, not a home-grown workaround. Free tier: https://console.upstash.com
GHIC_USE_ASYNC_PROCESSING=false
# QSTASH_TOKEN=...
# QSTASH_CURRENT_SIGNING_KEY=...
# QSTASH_NEXT_SIGNING_KEY=...
QSTASH_REGION=us-east-1
# This deploy's own public URL (no trailing slash) so QStash knows where to
# call back. Required for async processing to actually activate.
# GHIC_PUBLIC_BASE_URL=https://github-issue-classifier-dun.vercel.app

# Idempotency: dedup GitHub webhook deliveries by X-GitHub-Delivery so a
# retried delivery never produces a second comment. Always active (not
# gated by GHIC_USE_ASYNC_PROCESSING) once a store is available -- Postgres
# (shares GHIC_DATABASE_URL/DATABASE_URL with the ledger, no separate var)
# on Vercel, this file path on Docker/Fly, in-memory otherwise.
# GHIC_IDEMPOTENCY_FILE=data/idempotency.json

# Dev only: accept unsigned webhooks when no secret is set. NEVER in prod.
GHIC_ALLOW_UNSIGNED=false

# --- Repository Intelligence (RAG over the issue's own repository) --------
# Shallow-clones and indexes the repo an issue was opened on, retrieves the
# most relevant code, feeds it to the LLM as evidence, and shows the files
# in a "Repository Evidence" section. See
# models/REPOSITORY_INTELLIGENCE_CARD.md.
#
# Off by default: it shells out to git, writes clones and vector indexes to
# disk, and optionally calls an embeddings API. Needs a WRITABLE, PERSISTENT
# cache dir to be useful -- on Vercel's ephemeral filesystem an index does
# not survive between invocations, so this belongs on Docker/Fly with a
# volume. Auto-indexing also needs the QStash queue above; without it, index
# manually: python -m ghic.repo_index --repo owner/name
GHIC_USE_REPO_INTELLIGENCE=false
# GHIC_REPO_INTEL_CACHE_DIR=data/raw/repo_intel
# GHIC_REPO_INTEL_MAX_FILES=4000
# GHIC_REPO_INTEL_MAX_CHUNKS=20000
# GHIC_REPO_INTEL_TOP_K=10
# Below this cosine similarity, GHIC reports "no confident match" rather
# than showing the least-bad file. Raise it for stricter evidence.
# GHIC_REPO_INTEL_MIN_SIMILARITY=0.15
#
# Embeddings. "hashing" (default) is lexical, offline, free, and needs no
# key -- it matches an issue naming parse_csv to the function parse_csv, but
# not paraphrases with no shared vocabulary. "openai" is any OpenAI-
# compatible /v1/embeddings endpoint (OpenAI, Jina, Voyage, a local
# llama.cpp/Ollama server) and gives real semantic matching. Switching
# providers auto-invalidates existing indexes.
# GHIC_REPO_INTEL_EMBEDDING_PROVIDER=hashing
# GHIC_REPO_INTEL_EMBEDDING_MODEL=text-embedding-3-small
# GHIC_REPO_INTEL_EMBEDDING_BASE_URL=https://api.openai.com/v1
# GHIC_REPO_INTEL_EMBEDDING_DIMENSIONS=512
# Falls back to OPENAI_API_KEY when unset, matching GROQ_API_KEY's convention.
# GHIC_REPO_INTEL_EMBEDDING_API_KEY=

# --- Repository Intelligence: production infrastructure (Phase 1.5) ------
# Providers are resolved by name; nothing else in the engine branches on
# these. Naming an unimplemented provider fails loudly at startup rather
# than silently falling back to a local index that won't survive.
#
# Vectors: "local" (filesystem — dev/single-box) or "postgres" (pgvector,
# production). Postgres reuses DATABASE_URL, so production persistence
# needs no new infrastructure.
# GHIC_VECTOR_PROVIDER=local
# State:  auto | postgres | file | memory   (auto = Postgres, then file)
# GHIC_STATE_PROVIDER=auto
# Queue:  auto | qstash | inline | none     (inline is dev-only: a thread
#         dies with its process and nothing retries the lost job)
# GHIC_INDEX_QUEUE_PROVIDER=auto
#
# IMPORTANT: on an ephemeral filesystem (Vercel/Lambda/Cloud Run) with
# GHIC_VECTOR_PROVIDER unset or "local", repository intelligence DISABLES
# ITSELF and logs why — every cold start would otherwise re-index and throw
# the result away. Set GHIC_VECTOR_PROVIDER=postgres to run it there.
#
# Feature flags (no redeploy needed to change a rollout).
# GHIC_INCREMENTAL_INDEXING=true    # git-diff re-index instead of a rebuild
# GHIC_VECTOR_SEARCH=true           # master switch for retrieval
# GHIC_REPO_SUMMARIZATION=true
# GHIC_REPO_AUTO_INDEX=true         # queue unknown repos automatically
#
# Tuning.
# GHIC_INDEX_BATCH_SIZE=200         # max changed files before a full rebuild
# GHIC_REPO_CACHE_TTL=604800        # re-index after this many seconds
# GHIC_REPO_STALE_DAYS=30           # cleanup() drops indexes untouched this long

# --- Phase 2: Commit / PR / Historical Issue Intelligence ---------------
# Indexes a repository's history alongside its code, so GHIC can answer
# "when did this break", "is someone already fixing this", and "how did we
# resolve this last time". Reuses the same embedder, vector store, and
# retriever as code indexing — see models/REPOSITORY_INTELLIGENCE_CARD.md.
#
# Both off by default and separately gated: commit history needs a deeper
# clone (git fetch --deepen, on demand), issue history needs API calls or
# the project's own collected corpus. Requires GHIC_USE_REPO_INTELLIGENCE.
# GHIC_COMMIT_INTELLIGENCE=false
# GHIC_HISTORY_INTELLIGENCE=false
# GHIC_MAX_COMMITS=2000
# GHIC_MAX_HISTORY_ITEMS=2000

# --- Phase 3: Engineering Intelligence ----------------------------------
# Root-cause hypotheses, regression + release correlation, timeline,
# impact, and an ordered investigation plan — derived deterministically
# from evidence already retrieved (no extra LLM call, milliseconds not
# seconds). Every conclusion names the artifact it came from; a claim that
# can't is structurally impossible to construct.
# Requires GHIC_USE_REPO_INTELLIGENCE. See
# models/ENGINEERING_INTELLIGENCE_CARD.md.
# GHIC_ENGINEERING_INTELLIGENCE=false

# --- Phase 4: Engineering Automation ------------------------------------
# Advisory artifacts: implementation plans, triage checklists, draft PR
# descriptions, suggested tests, labels, and reviewers. Everything is
# advisory — GHIC does not merge, close, delete, assign, label, modify
# code, or change repository settings. That is enforced structurally, not
# by policy: ActionKind has no destructive members and AutomationService
# holds no GitHub client. See models/AUTOMATION_CARD.md.
#
# Each capability is independent and defaults off. Requires
# GHIC_USE_REPO_INTELLIGENCE (automation with no retrieved evidence would
# be generic advice, so it produces nothing instead).
# GHIC_FIX_SUGGESTIONS=false
# GHIC_PR_DRAFTS=false
# GHIC_TEST_PLANS=false
# GHIC_CHECKLISTS=false
# GHIC_SMART_LABELS=false
# GHIC_ASSIGNEE_RECOMMENDATIONS=false
# GHIC_DUPLICATE_WORKFLOW=false
