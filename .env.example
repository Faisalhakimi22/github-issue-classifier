# Copy to .env (gitignored). Never commit real values.

# ---------------------------------------------------------------------------
# Data collection / training (ghic.collect)
# ---------------------------------------------------------------------------
# Fine-grained PAT from https://github.com/settings/tokens with public repo
# read access — no write scopes needed. Only used for dataset collection.
GH_TOKEN=ghp_replace_me

# ---------------------------------------------------------------------------
# Webhook service (ghic.service) — all optional in dev, required in prod
# ---------------------------------------------------------------------------
# Secret configured on the GitHub App's webhook settings page.
GHIC_WEBHOOK_SECRET=

# GitHub App credentials (App settings -> General). The private key can be
# passed inline (GHIC_PRIVATE_KEY) or as a file path (GHIC_PRIVATE_KEY_PATH).
GHIC_APP_ID=
GHIC_PRIVATE_KEY_PATH=

# Model + decision threshold. Default prefers models/champion.joblib (the
# calibrated walk-forward-selected model) and falls back to rf_balanced.
GHIC_MODEL_PATH=
GHIC_THRESHOLD=0.5
# Per-repo overrides — run `python -m ghic.backtest` to calibrate these.
# GHIC_REPO_THRESHOLDS=owner/repo=0.35,other/repo=0.6
GHIC_REPO_THRESHOLDS=

# Actions. Everything defaults to the safe side: dry-run on, writes off.
GHIC_DRY_RUN=true
GHIC_POST_COMMENT=false
GHIC_APPLY_LABEL=false
GHIC_LABEL_NAME=predicted:actionable-bug
# Projects v2 board node ID (PVT_...). When set, issues predicted actionable
# are added to the board. Needs the App's Projects write permission.
GHIC_PROJECT_ID=

# Enrichment (author profile + latest release via the GitHub API).
GHIC_ENRICH=true

# Online-evaluation ledger (predictions graded when issues close).
# Unset = data/predictions.jsonl; empty = in-memory only.
# GHIC_LEDGER=data/predictions.jsonl

# Postgres-backed ledger — required on deploys with no persistent disk
# (Vercel; see docs/DEPLOYMENT.md "Deploying on Vercel"). Takes precedence
# over GHIC_LEDGER when set. Vercel's own Postgres integration injects
# DATABASE_URL/POSTGRES_URL automatically; GHIC_DATABASE_URL overrides both.
# GHIC_DATABASE_URL=postgres://user:pass@host:5432/dbname

# Duplicate candidates (requires models/dup_index.joblib from
# `python -m ghic.dupdetect --build-index`). Assistive only.
GHIC_SUGGEST_RELATED=true
GHIC_RELATED_MIN_SIM=0.55

# Category suggestion (requires models/category.joblib from
# `python -m ghic.category --train`). Assistive only — never auto-labeled.
GHIC_SUGGEST_CATEGORY=true

# Coarse resolution-time bucket in the API response (never in comments).
# Requires models/effort.joblib — only produced when the effort experiment
# meets its pre-declared ship bar (see models/EFFORT_CARD.md).
GHIC_ESTIMATE_EFFORT=true

# Maintainer suggestions in the API response (never an assignment, never an
# @-mention). Requires the dup index + data/processed/assignments.json
# (`python -m ghic.assign --collect`).
GHIC_SUGGEST_ASSIGNEES=true

# LLM-drafted "missing information" comments (off by default; degrades to a
# deterministic template without an API key). The classifier's decision is
# never delegated to the LLM. Skipped automatically when GHIC_USE_LLM_ANALYSIS
# below is on and succeeds -- that feature's own missing_information already
# covers this, so both would be a redundant second LLM call.
GHIC_DRAFT_MISSING_INFO=false
# ANTHROPIC_API_KEY=sk-ant-...
# GHIC_LLM_MODEL=claude-opus-4-8

# LLM-assisted issue analysis (category/priority/severity/summary/reasoning/
# missing-info/label suggestions) -- a separate feature from the missing-info
# drafter above, with its own model(s). Off by default until this flag AND at
# least one of the two keys below are set. Never recomputes or overrides the
# ML classifier's actionability probability -- see models/LLM_ANALYSIS_CARD.md.
#
# Two providers, priority chain: Groq is the fast primary (openai/gpt-oss-120b
# measured ~1.9s/call -- comfortably inside the webhook's response budget);
# OpenRouter is the fallback (nemotron free tier measured ~17s/call -- too
# slow as a primary, fine as a rarely-hit backup). Set GROQ_API_KEY alone,
# OPENROUTER_API_KEY alone, or both (chain: Groq tried first, OpenRouter only
# if Groq fails). Free keys: https://console.groq.com/keys and
# https://openrouter.ai/keys.
GHIC_USE_LLM_ANALYSIS=false
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=gsk_...
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Dev only: accept unsigned webhooks when no secret is set. NEVER in prod.
GHIC_ALLOW_UNSIGNED=false
