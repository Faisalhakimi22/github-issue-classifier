{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 10,
      "excludeFiles": "{tests/**,notebook/**,reports/**,data/**,docs/**,_archive/**}"
    }
  },
  "crons": [
    {
      "path": "/internal/retention",
      "schedule": "0 3 * * *"
    }
  ]
}
